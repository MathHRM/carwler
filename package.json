{
  "name": "carwler",
  "version": "1.0.0",
  "description": "Crawler para sites de carros usando Playwright",
  "main": "dist/cli/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "crawl": "tsx src/cli/index.ts crawl",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "bin": {
    "carwler": "./dist/cli/index.js"
  },
  "keywords": [
    "crawler",
    "scraper",
    "playwright",
    "cars",
    "olx"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.57.0",
    "winston": "^3.15.0",
    "dotenv": "^16.4.7",
    "commander": "^12.1.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

